<?xml version="1.0" encoding="utf-8"?>
<!--
    Fully transparent foreground layer.

    The Bengaluru artwork lives entirely in the adaptive icon's *background*
    layer (@mipmap/ic_launcher_bg_art), because it is a full-bleed raster
    gradient with no alpha channel. Insetting an opaque JPEG as the foreground
    would render as a square photo floating inside the launcher's circular
    mask. Supplying an explicit transparent foreground keeps the
    <adaptive-icon> well-formed without drawing anything on top.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0h108v108h-108z" />
</vector>
