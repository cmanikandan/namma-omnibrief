# Local development secrets. This file is git-ignored — never commit real keys.
# Copy to `.env` and fill in. See README "Adding your keys".
#
# Only these two values can be injected at build time. The OAuth 2.0 credentials
# have no BuildConfig fallback and must be entered in the app's Settings screen.

# Required for Gemini article/conference analysis.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# App-only bearer token: read-only endpoints ONLY.
# It CANNOT publish posts — X rejects it with 403 Unsupported Authentication on
# POST /2/tweets. Posting requires OAuth 2.0 User Context (tweet.write), which is
# configured in Settings, not here.
X_BEARER_TOKEN="MY_X_BEARER_TOKEN"
